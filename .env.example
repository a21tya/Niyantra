# AEGIS Environment Configuration
# JU Techfest 2026 · CY-03 · AI Agent Security Guard

# Server-side Gemini API credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model used for agent reasoning
# Supported examples: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional artifact threat-review model. Use a model enabled for your Google AI Studio project.
# The Gemini free tier may use submitted content to improve Google products; see the upload notice.
GEMINI_SCAN_MODEL=gemini-3.5-flash-lite

# Environment mode
NODE_ENV=development
